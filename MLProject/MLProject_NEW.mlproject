name: Titanic ML Project

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      data_path: {type: string, default: "data_preprocessed/titanic_processed.csv"}
      model_name: {type: string, default: "titanic-model"}
    command: "python modelling.py --data_path {data_path} --model_name {model_name}"
  
  train:
    parameters:
      data_path: {type: string, default: "data_preprocessed/titanic_processed.csv"}
      max_depth: {type: int, default: 10}
      n_estimators: {type: int, default: 100}
    command: "python modelling.py --data_path {data_path} --max_depth {max_depth} --n_estimators {n_estimators}"
  
  serve:
    parameters:
      model_uri: {type: string, default: "model"}
      port: {type: int, default: 5000}
    command: "mlflow models serve -m {model_uri} --host 0.0.0.0 --port {port}"
